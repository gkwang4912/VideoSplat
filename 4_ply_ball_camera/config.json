{
  "preview_fps": 30,
  "video_jobs": 4,
  "skip_completed_datasets": true,
  "path_degrees_per_frame": 1.0,
  "orientation_mode": "projected_canonical_up_with_path_specific_poles",
  "render_rgb": true,
  "render_alpha": false,
  "render_depth": false,
  "ply_splat": {
    "splat_scale": 1,
    "splat_scale_xyz": [1.0, 1.0, 1.0],
    "opacity_multiplier": 1.0,
    "opacity_power": 1.0,
    "sh_degree": null,
    "eps2d": 0.3,
    "radius_clip": 0.0,
    "point_size_pixels": 1.0
  },
  "mask_enabled": true,
  "mask_alpha_threshold": 0.01,
  "mask_weak_alpha_threshold": 0.05,
  "mask_local_mean_threshold": 0.08,
  "mask_box_blur_kernel": 5,
  "mask_min_occupied_component_pixels": 24,
  "mask_silhouette_alpha_threshold": 0.01,
  "mask_closing_kernel": 5,
  "mask_pass_background_color": [255, 0, 255],
  "mask_pass_foreground_color": [255, 255, 255],
  "mask_bg_distance_threshold": 25.0,
  "mask_pass_close_kernel": 3,
  "mask_pass_min_component_area": 24,
  "mask_overexpansion_strong_alpha_threshold": 0.5,
  "mask_max_added_fraction_of_silhouette": 0.20,
  "mask_max_strong_coverage_masked_fraction": 0.01,
  "background": "transparent",
  "bounds_percentiles": [1.0, 99.0],
  "near_plane": 0.01,
  "far_plane_scale": 3.0,
  "rasterize_mode": "antialiased",
  "radius_tolerance": 1e-9,
  "anchor_tolerance": 1e-9
}
